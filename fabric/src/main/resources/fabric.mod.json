  "authors": ["hrmcn"],
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["extravideoset.ExtraVideoSettingsMod"]
  },
  "mixins": [
    "extra_video_settings.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": ">=1.20.4",
    "fabric-api": "*",
    "iris": "*"
  }
}
